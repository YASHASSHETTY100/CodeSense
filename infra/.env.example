# --- Application Environment ---
ENV=production

# --- Authentication (JWT) - REQUIRED: Generate at least 32-char random secret in production ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Database: PostgreSQL in Docker, SQLite for local dev ---
# SQLite default: sqlite:///./codesense.db
# Docker PostgreSQL: postgresql+psycopg2://codesense:codesense@postgres:5432/codesense
DATABASE_URL=postgresql+psycopg2://codesense:codesense@postgres:5432/codesense
POSTGRES_USER=codesense
POSTGRES_PASSWORD=codesense
POSTGRES_DB=codesense

# --- Queue & Cache (Redis / Celery) ---
REDIS_URL=redis://redis:6379/0
CELERY_EAGER=false

# --- Repository & Document Storage ---
REPO_STORAGE_DIR=/code/data/repos
DOC_OUTPUT_DIR=/code/data/docs

# --- LLM Provider: offline | anthropic | openai ---
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# --- Embeddings: tfidf | st ---
EMBEDDING_BACKEND=tfidf

# --- GitHub OAuth (Optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=http://localhost:8000/auth/github/callback

# --- Credential Encryption (Fernet key) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_FERNET_KEY=

# --- CORS & Frontend Configuration ---
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000
