# --- Product auth (JWT) ---
JWT_SECRET=change-me-dev-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# --- Database: sqlite default for zero-dep local run; set to postgres for docker ---
# sqlite:///./codesense.db  OR  postgresql+psycopg2://codesense:codesense@postgres:5432/codesense
DATABASE_URL=sqlite:///./codesense.db
# --- Redis / Celery: eager inline mode if Redis absent ---
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=false
# --- Repo storage ---
REPO_STORAGE_DIR=./data/repos
DOC_OUTPUT_DIR=./data/docs
# --- LLM provider: anthropic | openai | offline (default offline = deterministic, no key needed) ---
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
# --- Embeddings: st (sentence-transformers) if installed else tfidf fallback ---
EMBEDDING_BACKEND=tfidf
# --- GitHub OAuth (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=http://localhost:8000/auth/github/callback
# --- Credential encryption (Fernet key; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
CREDENTIAL_FERNET_KEY=
# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
